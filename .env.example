GEMINI_API_KEY=your_gemini_api_key
PEXELS_API_KEY=your_pexels_api_key

# Optional: override the Gemini model used by modules/brain.py (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: override the Gemini image models used for thumbnails (default: gemini-3.1-flash-image,gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional: YouTube auto-upload (run scripts/authorize_youtube.py once to mint these)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional: web UI (webapp.py)
APP_PASSWORD=
FLASK_SECRET_KEY=

# --- Video ---
# Who writes a film's prompts when you don't choose: local (the default), gemini or claude.
# LLM_PROVIDER=local
# From platform.claude.com. Paid per use.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Your phone is told when a job finishes or fails, through ntfy (https://ntfy.sh): install its app and subscribe to
# a topic only you know, then set it here. NTFY_SERVER if you run your own.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
